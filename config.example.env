# Конфигурация Blueberry. Копируется в ~/.config/blueberry/config.env
# Файл читается как shell (KEY=value), секретов здесь нет — токен лежит в ~/.config/blueberry/token.

# --- LM Studio ---
LMS_BIN="$HOME/.lmstudio/bin/lms"
LMS_PORT=1234
LMS_BIND=127.0.0.1          # LM Studio всегда только на localhost
MODEL_KEY="google/gemma-4-e4b"
MODEL_IDENTIFIER="gemma"
MODEL_CONTEXT=8192

# --- Прокси (в сеть смотрит он, а не LM Studio) ---
# На время разработки 127.0.0.1. Итоговое значение — 0.0.0.0 (меняется вручную, только при включённом токене).
PROXY_HOST=127.0.0.1
PROXY_PORT=8787
PROXY_MAX_BODY_BYTES=262144
PROXY_MAX_CONCURRENT=2

# --- Watchdog ---
WD_INTERVAL=30                 # период проверки, секунд
WD_BATTERY_MIN_PERCENT=15      # ниже этого заряда без зарядки: аварийная остановка
WD_THERMAL_LEVEL=2             # тепловое давление: 1 умеренное, 2 сильное, 3 критическое
WD_CPU_SPEED_LIMIT_MIN=70      # лимит скорости CPU (%) ниже этого значения считается троттлингом
WD_THERMAL_SUSTAIN_SECONDS=180 # сколько перегрев должен держаться до остановки
WD_IDLE_MINUTES=20             # без запросов столько минут: выгрузить модель

# --- Обнаружение телефоном ---
BONJOUR_NAME=Blueberry         # имя сервиса _blueberry._tcp (анонс включается, когда PROXY_HOST не localhost)
