# Конфигурация Blueberry. Копируется в ~/.config/blueberry/config.env
# Файл читается как shell (KEY=value), секретов здесь нет — токен лежит в ~/.config/blueberry/token.

# --- LM Studio ---
LMS_BIN="$HOME/.lmstudio/bin/lms"
LMS_PORT=1234
LMS_BIND=127.0.0.1          # LM Studio всегда только на localhost
MODEL_KEY="google/gemma-4-e4b"
MODEL_IDENTIFIER="gemma"
MODEL_CONTEXT=8192
